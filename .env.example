# ═══════════════════════════════════════════════════════════════════════
# Shaant Roop — Backend Environment Variables (Example)
# Copy this file to .env and replace the values with real secrets.
# ═══════════════════════════════════════════════════════════════════════

# Database Configuration
# The DB_URL provided matches the docker-compose service name.
DB_URL=jdbc:postgresql://db:5432/shaantroop_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# JWT Configuration
# Generate a strong 256-bit+ secure key for production
JWT_SECRET=your_jwt_secret_key_needs_to_be_long_and_secure
JWT_EXPIRATION=86400000

# Initial Admin User Details
# This user will be created on first startup if no users exist.
ADMIN_EMAIL=admin@shaantroop.com
ADMIN_PASSWORD=admin_super_secret

# Google OAuth2
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
